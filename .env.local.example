# EmailJS — Obtén tus credenciales en https://emailjs.com (cuenta gratuita)
# Dashboard → Email Services → Add New Service → Gmail
# Dashboard → Email Templates → Create New Template
# Dashboard → Account → Public Key

NEXT_PUBLIC_EMAILJS_SERVICE_ID=TU_SERVICE_ID
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=TU_TEMPLATE_ID
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=TU_PUBLIC_KEY

# Supabase público — seguro para el navegador, pero no lo hardcodees en el código.
NEXT_PUBLIC_SUPABASE_URL=https://svbvkgvtjksvjfvigiah.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICABLE

# Compatibilidad temporal. Usa solo si tu proyecto aún no muestra una publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# Solo servidor. Necesaria únicamente para invitar usuarios desde /portal/admin/usuarios.
# Nunca uses el prefijo NEXT_PUBLIC en esta variable.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# URL pública usada en los correos de recuperación de contraseña.
NEXT_PUBLIC_SITE_URL=https://www.deepsunstudio.com

# WhatsApp público (solo dígitos con código de país, p. ej. 57XXXXXXXXXX).
# En el repositorio había dos números distintos; confirma el correcto antes de definirlo.
# Sin esta variable, los botones de WhatsApp del sitio público no se muestran.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google Search Console: pega aquí solo el valor del token de verificación (si está vacío no se emite ninguna etiqueta).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
